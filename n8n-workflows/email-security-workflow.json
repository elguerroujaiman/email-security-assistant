    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const j = item.json;\n  \n  // Simple ID generator (no crypto needed)\n  const simpleId = 'n8n-' + Date.now() + '-' + Math.random().toString(36).substring(2, 8);\n  \n  const messageId = j.messageId || '<' + simpleId + '@n8n>';\n  const date = j.date ? new Date(j.date).toUTCString() : new Date().toUTCString();\n  const from = j.from?.text || j.from?.value?.[0]?.address || 'unknown@localhost';\n  const to = j.to?.text || j.to?.value?.[0]?.address || 'unknown@localhost';\n  const subject = j.subject || '(no subject)';\n  const body = j.text || j.html || '';\n  \n  const headers = [\n    `Message-ID: ${messageId}`,\n    `Date: ${date}`,\n    `From: ${from}`,\n    `To: ${to}`,\n    `Subject: ${subject}`,\n    `MIME-Version: 1.0`,\n    `Content-Type: text/plain; charset=\"UTF-8\"`\n  ].join('\\r\\n');\n  \n  const rawEmail = headers + '\\r\\n\\r\\n' + body;\n  \n  results.push({\n    json: {\n      rawEmail: rawEmail,\n      subject: j.subject,\n      from: from,\n      to: to,\n      text: j.text,\n      html: j.html,\n      messageId: messageId,\n      links: extractLinks(j.text, j.html)\n    }\n  });\n}\n\nfunction extractLinks(text, html) {\n  const combined = (text || '') + ' ' + (html || '');\n  const matches = combined.match(/https?:\\/\\/[^\\s<<>\"{}|\\\\^`\\[\\]]+/g) || [];\n  const unique = [...new Set(matches)];\n  return unique.map(url => {\n    try {\n      const u = new URL(url);\n      return { url, domain: u.hostname, is_shortened: /bit\\.ly|t\\.co|tinyurl|ow\\.ly/.test(u.hostname) };\n    } catch(e) { return null; }\n  }).filter(Boolean);\n}\n\nreturn results;"
      },
